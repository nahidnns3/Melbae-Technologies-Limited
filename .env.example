# Copy to .env.local for local development. Never commit real values.

# Canonical public origin of the corporate site (no trailing slash).
# Used for canonical URLs, sitemap, Open Graph and structured data.
# VERIFY BEFORE LAUNCH: the official Melbae corporate domain.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery. The form posts to a server action which sends the
# inquiry by email through Resend's HTTP API. When RESEND_API_KEY is unset,
# the form reports that it is not yet accepting submissions rather than
# pretending to succeed.
RESEND_API_KEY=
# Mailbox that receives inquiries (VERIFY: official Melbae inbox).
CONTACT_INBOX_EMAIL=
# Verified sender identity on the Resend account, e.g. "Melbae Website <no-reply@example.com>".
CONTACT_FROM_EMAIL=

# Public contact email shown on the site. Leave empty to hide the mailto link
# until the official address is confirmed. VERIFY BEFORE LAUNCH.
NEXT_PUBLIC_CONTACT_EMAIL=
